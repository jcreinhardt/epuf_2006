# macOS
.DS_Store
__MACOSX/

# Editor / IDE
.vscode/
.idea/

# Claude Code — personal, machine-specific (absolute paths); not shared
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.python-version
.venv/
venv/
env/

# Logs
*.log

# External replication packages (own git repos, multi-GB datastores) — clone/download
# separately; e.g. the CMS (JF 2025) package used by code/dynamics.
replication_repos

# Data and generated artifacts — large and/or regenerable, not version-controlled.
# Rebuild the DB from raw_data with code/data_import/build_epuf_duckdb.sql
# + code/data_import/extract_table_4B1.py.
# (ignore contents but keep the directory skeletons via .gitkeep at any depth)
raw_data/*
processed_data/*
output/**
!raw_data/.gitkeep
!processed_data/.gitkeep
!output/**/
!output/**/.gitkeep

# LaTeX build products — the deck is regenerable from its .tex (xelatex, run twice).
# Decks now live one level down, in presentation/<YYYY-MM-DD>/, so these match at any
# depth. A compiled deck is a .pdf sitting next to its .tex; a FIGURE is a .pdf under
# figures/ and is kept, because a snapshot's whole point is that it still renders after
# the code that made it has moved on.
presentation/**/*.pdf
!presentation/**/figures/*.pdf
presentation/**/*.aux
presentation/**/*.nav
presentation/**/*.out
presentation/**/*.snm
presentation/**/*.toc
presentation/**/*.log

# External replication packages: nested git clones (CMS, GKOS_2022), cloned or symlinked
# in, not authored here. `--mode ols` and compare_g_cms.py read CMS's average-wage series
# from this tree, so it is a real dependency -- see README for where to get it.
replication_repos
