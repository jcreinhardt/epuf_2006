# macOS
.DS_Store
__MACOSX/

# Editor / IDE
.vscode/
.idea/

# Claude Code — personal, machine-specific (absolute paths); not shared
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.python-version
.venv/
venv/
env/

# Logs
*.log

# External replication packages (own git repos, multi-GB datastores) — clone/download
# separately; e.g. the CMS (JF 2025) package used by code/dynamics.
replication_repos

# Source data and the DB — large, and regenerable from raw_data with
# code/data_import/build_epuf_duckdb.sql + code/data_import/extract_table_4B1.py.
# (ignore contents but keep the directory skeletons via .gitkeep at any depth)
raw_data/*
processed_data/*
!raw_data/.gitkeep
!processed_data/.gitkeep

# output/ IS tracked, except for figures. The split is by COST, not by size: a CSV in
# here is minutes to hours of compute — the joint cross-section solve, the SMM over
# cohort × sex blocks — and losing one means re-running an estimator, while every figure
# is seconds away from those CSVs. A "larger than N MB" rule would get this exactly
# backwards, because the expensive artifacts are the big ones (the parameter surfaces
# are 1–2 MB each) and the cheap ones are the small ones.
# Ignore the FILES, not the plots/ directories: eight cross-section plot scripts write
# into theirs without creating it, so the skeleton has to survive a fresh clone.
output/**/*.pdf
output/**/*.png
output/**/*.svg
!output/**/.gitkeep

# LaTeX build products — the deck is regenerable from its .tex (xelatex, run twice).
# Decks now live one level down, in presentation/<YYYY-MM-DD>/, so these match at any
# depth. A compiled deck is a .pdf sitting next to its .tex.
presentation/**/*.pdf
# ...but a report's own figures, written next to it by the plotting code that lives in
# the same folder, are the report's CONTENT, not a build product: a snapshot's whole
# point is that it still renders after the code that made it has moved on.
!presentation/**/figures/*.pdf
presentation/**/*.aux
presentation/**/*.nav
presentation/**/*.out
presentation/**/*.snm
presentation/**/*.toc
presentation/**/*.log

# External replication packages: nested git clones (CMS, GKOS_2022), cloned or symlinked
# in, not authored here. `--mode ols` and compare_g_cms.py read CMS's average-wage series
# from this tree, so it is a real dependency -- see README for where to get it.
# NO trailing slash: inside a git worktree this path is a SYMLINK to the main checkout,
# and "replication_repos/" would match only a real directory.
replication_repos
